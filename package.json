{
  "name": "augur",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.11.1",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "mcp",
    "workers/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --workspace frontend run build",
